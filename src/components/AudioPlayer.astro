---
const { tracks = [], lang = 'fr', title, intro, id = 'listen' } = Astro.props;
const isEn = lang === 'en';
const heading = title || (isEn ? 'One-minute snippets.' : 'Extraits d’une minute.');
const description = intro || (isEn ? 'Stream each excerpt or download it individually in MP3 and WAV.' : 'Écoutez chaque extrait ou téléchargez-le individuellement en MP3 et WAV.');
---
<section class="rule mx-auto max-w-[1600px] px-5 py-24 md:px-8 md:py-36" id={id}>
  <div class="grid gap-12 lg:grid-cols-[.72fr_1.28fr]">
    <div>
      <div class="kicker mb-5 text-white/45">{isEn ? 'Listen / Download' : 'Écouter / Télécharger'}</div>
      <h2 class="section-title">{heading}</h2>
      <p class="mt-8 max-w-md text-lg leading-relaxed text-white/60">{description}</p>
    </div>
    <div class="audio-player" data-audio-player>
      <audio preload="metadata" data-main-audio></audio>
      <div class="space-y-2">
        {tracks.map((track, index) => (
          <article class="audio-track" data-track data-src={track.mp3} data-title={track.title}>
            <button class="audio-play" type="button" data-play aria-label={`${isEn ? 'Play' : 'Lire'} ${track.title}`}><span data-icon>▶</span></button>
            <div class="min-w-0 flex-1">
              <div class="flex items-baseline justify-between gap-4">
                <div class="truncate"><span class="mr-3 text-xs text-white/35">{String(index + 1).padStart(2, '0')}</span><strong class="text-base md:text-lg">{track.title}</strong></div>
                <span class="text-xs tabular-nums text-white/40" data-time>01:00</span>
              </div>
              <input class="audio-progress" data-progress type="range" min="0" max="100" value="0" step="0.1" aria-label={`${isEn ? 'Progress' : 'Progression'} ${track.title}`} />
            </div>
            <div class="audio-downloads"><a href={track.mp3} download>MP3</a><a href={track.wav} download>WAV</a></div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll('[data-audio-player]').forEach((player) => {
    const audio = player.querySelector('[data-main-audio]');
    const rows = [...player.querySelectorAll('[data-track]')];
    let activeRow = null;
    const formatTime = (seconds) => { if (!Number.isFinite(seconds)) return '00:00'; const mins=Math.floor(seconds/60); const secs=Math.floor(seconds%60); return `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}`; };
    const resetRows = () => rows.forEach((row)=>{ row.classList.remove('is-playing'); row.querySelector('[data-icon]').textContent='▶'; });
    rows.forEach((row)=>{
      const play=row.querySelector('[data-play]'); const progress=row.querySelector('[data-progress]');
      play.addEventListener('click',async()=>{
        const same=activeRow===row;
        if(same&&!audio.paused){audio.pause();row.classList.remove('is-playing');row.querySelector('[data-icon]').textContent='▶';return;}
        if(!same){resetRows();activeRow=row;audio.src=row.dataset.src;audio.load();}
        try{await audio.play();resetRows();row.classList.add('is-playing');row.querySelector('[data-icon]').textContent='Ⅱ';}catch(error){console.error(error);}
      });
      progress.addEventListener('input',()=>{if(activeRow!==row||!audio.duration)return;audio.currentTime=(Number(progress.value)/100)*audio.duration;});
    });
    const update=()=>{if(!activeRow)return;const duration=audio.duration||60;activeRow.querySelector('[data-progress]').value=String((audio.currentTime/duration)*100||0);activeRow.querySelector('[data-time]').textContent=`${formatTime(audio.currentTime)} / ${formatTime(duration)}`;};
    audio.addEventListener('timeupdate',update);audio.addEventListener('loadedmetadata',update);audio.addEventListener('ended',()=>{if(!activeRow)return;activeRow.classList.remove('is-playing');activeRow.querySelector('[data-icon]').textContent='▶';activeRow.querySelector('[data-progress]').value='0';audio.currentTime=0;});
  });
</script>

---
const { lang = 'fr' } = Astro.props;
const isEn = lang === 'en';
---
<footer class="rule mx-auto max-w-[1600px] px-5 py-10 text-xs uppercase tracking-[.12em] text-white/45 md:px-8">
  <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <span>Bruit Sourd — {isEn ? 'Press / Media' : 'Presse / Médias'}</span>
    <a href="mailto:contact@bruitsourd.com" class="hover:text-white">contact@bruitsourd.com</a>
  </div>
</footer>
